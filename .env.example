# Default gateway — verified Meta Model API (https://dev.meta.ai/docs). Users bring their own key (BYOK). No server keys ever in normal mode.
META_GATEWAY_URL=https://api.meta.ai/v1
# Scraper
SCRAPE_TIMEOUT_MS=15000
SCRAPE_MAX_BYTES=2000000

# --- JUDGING MODE (temporary, server-only) ---
# During judging, set these on the HOST (Vercel/hosting dashboard or a local
# .env.local that you NEVER commit) so judges get zero-friction real AI
# with no key paste. After judging, delete them to return to pure BYOK.
# META_API_KEY=sk-your-real-meta-key-here
# JUDGING_MODE=1
# NEXT_PUBLIC_JUDGING_MODE=1

