{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "META_GATEWAY_URL": "https://api.meta.ai/v1",
    "SCRAPE_TIMEOUT_MS": "15000",
    "SCRAPE_MAX_BYTES": "2000000"
  }
}
